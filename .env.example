# Base URL of the CMS API, frozen into the bundle at build time.
#
# Keep the default /api/v1 when this site forwards /api to the
# backend: the Vite dev server does it locally, and a rewrite does it on
# Vercel/Netlify (see README). Otherwise use the absolute API URL, e.g.
# https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Where `npm run dev` and `npm run preview` forward /api (a deployed API URL works too).
API_PROXY_TARGET=http://localhost:4000
